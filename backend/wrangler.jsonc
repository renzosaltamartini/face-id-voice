{
  "name": "nova-face-id",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "NOVA_WEB_ORIGIN": "https://nova-face-id.vercel.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-accounts",
      "database_id": "8feea4d2-2eb3-45e1-8778-5b5f9ee3c387"
    }
  ]
}
