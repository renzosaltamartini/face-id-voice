{
  "framework": null,
  "buildCommand": "node scripts/build-vercel.cjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/room",
      "destination": "/panel/room",
      "permanent": false
    },
    {
      "source": "/room/",
      "destination": "/panel/room",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/face-id-voice/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/panel/ceo/", "destination": "/index.html" },
    { "source": "/panel/ceo", "destination": "/index.html" },
    {
      "source": "/face-id-voice/",
      "destination": "/index.html"
    },
    {
      "source": "/face-id-voice",
      "destination": "/index.html"
    },
    {
      "source": "/face-id-voice/panel",
      "destination": "/index.html"
    },
    {
      "source": "/panel",
      "destination": "/index.html"
    },
    {
      "source": "/panel/",
      "destination": "/index.html"
    },
    {
      "source": "/face-id-voice/panel/",
      "destination": "/index.html"
    },
    {
      "source": "/panel/room",
      "destination": "/panel/room/index.html"
    },
    {
      "source": "/face-id-voice/panel/room",
      "destination": "/panel/room/index.html"
    },
    {
      "source": "/face-id-voice/panel/room/",
      "destination": "/panel/room/index.html"
    },
    {
      "source": "/face-id-voice/panel/room/:asset",
      "destination": "/panel/room/:asset"
    },
    {
      "source": "/face-id-voice/shared/:asset",
      "destination": "/shared/:asset"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
